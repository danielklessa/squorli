# ---- Required values ----
PUBLIC_DOMAIN=chat.example.org
POSTGRES_PASSWORD=change-me

# Public key (64 hex) that becomes owner on the first login. Empty = the first user who signs in with an account (a directory
# handle, or a server account `~name` registered on this server). A server account gets a fresh key at its registration, so
# this can only name the key of a directory account.
#OWNER_PUBLIC_KEY=
# The owner as a server account (~name): whoever registers a server account with this code becomes the owner, while there is
# none (also where server accounts are off). Make one with `openssl rand -hex 12`. A name alone would not do: anybody could
# register it first. With OWNER_PUBLIC_KEY as well, either way works; set alone, nobody becomes owner without the code.
#OWNER_SETUP_CODE=
# Initial name of the server (can be changed later in the admin panel). Default: Community
#SERVER_NAME=Mein Server
# Upper limit for attachments in MB. Default: 25
#MAX_UPLOAD_MB=25
# Sessions: a sign-in lasts SESSION_TTL_DAYS at most (default 30) and ends after SESSION_IDLE_DAYS without use (default 14; 0 = off).
#SESSION_TTL_DAYS=30
#SESSION_IDLE_DAYS=14
# Operator limits (docs/features/limits.md), for a server run for other people; each one is off when unset (the installer sets
# STORAGE_QUOTA_MB to 80 % of the free space on a fresh installation; change it here). STORAGE_QUOTA_MB:
# every file the server keeps (attachments, preview pictures, report copies, avatars, the icon) in MB, then uploads answer
# 413 storage_full. VOICE_SEATS_MAX: how many people may sit in voice channels at the same time (409 voice_seats_full).
# MEMBER_MAX: how many members the server admits (403 server_full). DB_POOL_MAX: PostgreSQL connections held open, default 10.
#STORAGE_QUOTA_MB=
#VOICE_SEATS_MAX=
#MEMBER_MAX=
#DB_POOL_MAX=10
# Link previews: the server fetches the pages members link to (public hosts only: title, description, one picture) and
# keeps the pictures in its data volume, so readers never contact the linked host. false = no previews and no such
# requests (then the server needs no outgoing http/https for the chat). Default: true
#LINK_PREVIEWS=true
# Scales every rate limit of the server (docs/features/rate-limits.md): 2 = twice as many requests; 0 = off, for load tests only.
#RATE_LIMIT_FACTOR=1
# Logging (docs/features/logging.md). Level of the app server: fatal, error, warn, info, debug. Default: info
#LOG_LEVEL=info
# true = one line per request with the caller's IP address, for troubleshooting only; switch it off again afterwards.
# Default false: no request log, only requests that end in a server error, without the address.
#LOG_REQUESTS=false

# ---- Operating mode ----
# bundled  = the bundled Caddy handles TLS on 443
# external = an existing reverse proxy terminates TLS, we listen internally on 3000
PROXY_MODE=external
# Public prebuilt image: https://github.com/danielklessa/squorli/pkgs/container/squorli-server
# Set APP_IMAGE, then pull with the matching Compose profile and run up -d --no-build.
# stable = the newest published release (signed); a version tag or a digest pins one; latest follows the development
# (unsigned). Empty = build locally. The installer checks the signature of stable and of the versions before a start;
# IMAGE_VERIFY=off switches that off (only when it is clear why, e.g. no way to the Sigstore services).
#APP_IMAGE=ghcr.io/danielklessa/squorli-server:stable
#IMAGE_VERIFY=on
# Only relevant in external mode: which senders' X-Forwarded-* headers are trusted.
# Comma-separated IPs/CIDRs. Default: Docker networks and private ranges. Proxy on another host with a public IP: add that IP.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1
# Only with proxies/remote-proxy.ports.yml (proxy on another host): address of this host on which 3000 and 7880 should listen.
#PROXY_BIND_IP=10.0.0.5
# Only for an installation without Docker (Windows package): address the app server listens on, 127.0.0.1 for a proxy on the
# same machine. Leave it unset with Docker Compose: inside the container the server must listen on every interface (the
# default 0.0.0.0), which address of the host reaches it is decided by the overlays and PROXY_BIND_IP.
#LISTEN_HOST=127.0.0.1
# Only for an installation without Docker (Windows package, its setup makes one): what `squorli doctor` sends to read the
# setup check without a session (header x-squorli-doctor, at least 32 characters). Leave it unset with Docker Compose: there
# the command asks from inside the container over loopback, which no proxy can do.
#DOCTOR_TOKEN=

# ---- Ports on the host (change them when another service already uses one) ----
# Media go straight to LiveKit and must be open to everyone; LiveKit announces these numbers to the clients. The setup check
# (Verwaltung > Server > Verbindung prüfen, `squorli doctor`) reads the same values to name and probe them.
#LIVEKIT_TCP_PORT=7881
#LIVEKIT_UDP_PORT=7882
# Only in external mode with proxies/nginx.ports.yml or proxies/remote-proxy.ports.yml: where the proxy reaches the app
# server and LiveKit signaling. The bundled Caddy always needs 80 and 443 (Let's Encrypt).
#APP_PORT=3000
#LIVEKIT_HTTP_PORT=7880

# ---- LiveKit ----
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-at-least-32-random-characters
# Public IP of the server. Leave empty = LiveKit determines it itself (use_external_ip). The setup check probes the media
# ports at this address when it is set (a media node on another machine than PUBLIC_DOMAIN).
LIVEKIT_NODE_IP=
# A home connection whose public address changes (docs/features/dynamic-ip.md): true = `squorli nodeip` keeps
# LIVEKIT_NODE_IP current (the router by UPnP, else LIVEKIT_NODE_IP_URL, else the directory's GET /api/ip) and restarts
# LiveKit when it changed; the installer sets it and the job up. LIVEKIT_ROUTER_IP names the router when the default
# route is not it (a VPN). LIVEKIT_NODE_IP_URL: an address on the web that answers with the caller's IP, asked over IPv4.
#LIVEKIT_DYNAMIC_IP=
#LIVEKIT_ROUTER_IP=
#LIVEKIT_NODE_IP_URL=
# Only set if clients should NOT reach LiveKit via https://PUBLIC_DOMAIN/rtc (default: wss://PUBLIC_DOMAIN).
#LIVEKIT_PUBLIC_URL=

# ---- Directory service (M6: handles, key backup, authenticator) ----
# Separate deployment from the repo squorli-directory on its own host with its own domain. Empty = no directory.
DIRECTORY_URL=https://id.example.org
# Server accounts (`~name`, docs/features/local-accounts.md): every sign-in needs an account, a directory handle or a server
# account of this server. true/false fixes whether server accounts may be registered (the admin panel's switch is then
# locked); empty = the admin panel decides (default off). Without DIRECTORY_URL they are always allowed: the only way in.
#LOCAL_ACCOUNTS=true
# REQUIRE_ACCOUNT is deprecated since 25 September 2026 (an account is always required now) and ignored.
# URL under which the directory reaches this server's /api/health (host proof for the server registration).
# Default https://PUBLIC_DOMAIN/api/health; set it only if the server is reachable under a different address.
# It must end in /api/health on the server's own host (the directory accepts no other path since 25 September 2026).
#DIRECTORY_PROOF_URL=
