{
  "name": "@squorli/server",
  "version": "0.14.0",
  "private": true,
  "squorli": {
    "autoUpdateFrom": "0.6.0"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p ../../packages/plugin-api/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "smoke": "node scripts/smoke.mjs",
    "smoke:suspended": "node scripts/smoke-suspended.mjs",
    "smoke:devices": "node scripts/smoke-devices.mjs",
    "smoke:plugins": "node scripts/smoke-plugins.mjs",
    "plugin:check": "tsx src/plugin-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.0.0",
    "@jitl/quickjs-singlefile-mjs-release-sync": "^0.32.0",
    "@noble/ed25519": "^3.0.0",
    "@squorli/link-preview": "workspace:*",
    "@squorli/protocol": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "livekit-server-sdk": "^2.7.0",
    "postgres": "^3.4.4",
    "quickjs-emscripten-core": "^0.32.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  }
}
