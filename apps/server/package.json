{
  "name": "@squorli/server",
  "version": "0.7.0",
  "private": true,
  "squorli": {
    "autoUpdateFrom": "0.6.0"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "smoke": "node scripts/smoke.mjs",
    "smoke:suspended": "node scripts/smoke-suspended.mjs",
    "smoke:devices": "node scripts/smoke-devices.mjs"
  },
  "dependencies": {
    "@squorli/link-preview": "workspace:*",
    "@squorli/protocol": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@noble/ed25519": "^2.1.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "livekit-server-sdk": "^2.7.0",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.28.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "ws": "^8.21.3"
  }
}
