<?xml version="1.0" encoding="utf-8"?>
<!-- The start of Android before 12 (styles.xml): the brand's dark ground and the logo in the middle, unscaled, so it is
     never distorted whatever the screen's shape (splash_icon generated by tools/mobile-icons.mjs). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/squorli_ground" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_icon" />
    </item>
</layer-list>
