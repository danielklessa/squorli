NODE_ENV=development
PORT=3000
# Address the server listens on. Default 0.0.0.0 (every interface, so a second device on the LAN reaches the dev server).
#LISTEN_HOST=0.0.0.0
PUBLIC_DOMAIN=localhost
DATABASE_URL=postgres://chat:chat@localhost:5432/chat
PROXY_MODE=bundled
TRUSTED_PROXIES=127.0.0.1
LIVEKIT_URL=http://localhost:7880
# No proxy in dev: the browser connects directly to the LiveKit container.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Address the dev LiveKit offers browsers for media. Empty = 127.0.0.1 (this machine only).
# Second device on the LAN: LAN IP of this machine. Testing from outside via router NAT: public IP of the router.
#LIVEKIT_DEV_NODE_IP=
# LiveKit's media ports as the dev stack publishes them (compose.dev.yml); the setup check names and probes them. Defaults 7881/7882.
#LIVEKIT_TCP_PORT=7881
#LIVEKIT_UDP_PORT=7882
# Attachments are stored here (relative to apps/server). Docker: /app/data (volume).
DATA_DIR=./data
# Link previews (default true). The server asks the linked hosts itself; false turns them off.
#LINK_PREVIEWS=true
# Operator limits (docs/features/limits.md), all off when unset: MB for every stored file, seats in voice channels, members, database connections (default 10).
#STORAGE_QUOTA_MB=
#VOICE_SEATS_MAX=
#MEMBER_MAX=
#DB_POOL_MAX=10
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-secret-secret-secret-secret
# Directory service (M6): separate repo squorli-directory, `pnpm dev` there starts it on :3100. Empty = no directory.
DIRECTORY_URL=http://localhost:3100
# Server accounts (`~name`): true/false fixes whether they may be registered; empty = admin panel decides. Always allowed without DIRECTORY_URL.
#LOCAL_ACCOUNTS=
# Host proof for the server registration at the directory; default with PUBLIC_DOMAIN=localhost: http://localhost:PORT/api/health
#DIRECTORY_PROOF_URL=http://localhost:3000/api/health
