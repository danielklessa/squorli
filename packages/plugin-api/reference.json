{
  "apiVersion": 1,
  "apiMin": 1,
  "capabilities": [
    {
      "id": "members.read",
      "risk": "low",
      "text": {
        "en": "See the member list (names, roles, when somebody joined) and learn when members join, leave or change roles.",
        "de": "Die Mitgliederliste sehen (Namen, Rollen, Beitrittsdatum) und erfahren, wenn Mitglieder beitreten, gehen oder Rollen wechseln."
      }
    },
    {
      "id": "roles.manage",
      "risk": "high",
      "text": {
        "en": "Give and take the roles you pick in its settings. Never roles with administrator rights.",
        "de": "Die Rollen vergeben und entziehen, die du in seinen Einstellungen auswählst. Nie Rollen mit Administratorrecht."
      }
    },
    {
      "id": "messages.read",
      "risk": "high",
      "text": {
        "en": "Read every message in the channels you pick in its settings.",
        "de": "Alle Nachrichten in den Kanälen lesen, die du in seinen Einstellungen auswählst."
      }
    },
    {
      "id": "messages.write",
      "risk": "low",
      "text": {
        "en": "Write messages under its own name in the channels you pick in its settings, and where a member runs one of its commands.",
        "de": "Unter eigenem Namen Nachrichten schreiben: in den Kanälen, die du in seinen Einstellungen auswählst, und dort, wo ein Mitglied einen seiner Befehle ausführt."
      }
    }
  ],
