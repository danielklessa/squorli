<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS as the reverse proxy in front of Squorli (external mode), on the same machine.
  Needs the modules URL Rewrite and Application Request Routing and the Windows feature "WebSocket Protocol";
  see README.md in this folder for the settings that cannot stand in this file.
  Put this file into the root folder of the site that serves chat.example.org (an empty folder is enough).
  Replace 3000 and 7880 when the setup chose other ports (install.ps1 names them at its end).
-->
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <rewrite>
      <rules>
        <rule name="Squorli: HTTPS only" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <!-- Let's Encrypt clients for IIS (win-acme, Certify) answer the check below this path themselves. -->
            <add input="{URL}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{UNENCODED_URL}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <!-- LiveKit signaling (WebSocket) and validation. UNENCODED_URL keeps the address as the client sent it, the query included. -->
        <rule name="Squorli: LiveKit" stopProcessing="true">
          <match url="^rtc" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:7880{UNENCODED_URL}" appendQueryString="false" />
        </rule>
        <!-- Everything else: app server (API, WebSocket /api/ws, static web client) -->
        <rule name="Squorli: app server" stopProcessing="true">
          <match url=".*" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <!-- Bytes; at least MAX_UPLOAD_MB (25) plus the form data around the file. IIS answers 404.13 above it. -->
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>
    <!-- The answers come from Squorli as they are; IIS's own error pages would hide the API's JSON errors. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
