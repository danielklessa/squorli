# Configuration of a Squorli installation on Windows (C:\ProgramData\Squorli\.env). install.ps1 writes it and keeps
# what is there on every further run; secrets are never replaced. The app server reads this file at its start
# (node --env-file), so a change needs "squorli restart server". Ports, the domain and the way of HTTPS also stand in
# config\livekit.yaml, config\Caddyfile and the firewall rules: change those by running install.ps1 again.
# Readable by administrators and the app server's service only.

# ---- Required values ----
PUBLIC_DOMAIN=chat.example.org
POSTGRES_PASSWORD=change-me
# The same password inside the address the app server connects to.
DATABASE_URL=postgres://chat:change-me@127.0.0.1:5432/chat

# Public key (64 hex) of a Squorli account that becomes owner on its first login (only with a directory).
#OWNER_PUBLIC_KEY=
# The owner as a server account (~name): whoever registers a server account with this code becomes the owner, while
# there is none. install.ps1 makes one.
#OWNER_SETUP_CODE=
# Initial name of the server (can be changed later in the admin panel). Default: Community
#SERVER_NAME=Mein Server
# Upper limit for attachments in MB. Default: 25
#MAX_UPLOAD_MB=25
# Operator limits (docs/features/limits.md), each off when unset: MB for every stored file (413 storage_full), people in voice
# channels at once (409 voice_seats_full), members (403 server_full), PostgreSQL connections held open (default 10).
#STORAGE_QUOTA_MB=
#VOICE_SEATS_MAX=
#MEMBER_MAX=
#DB_POOL_MAX=10
# Link previews: the server fetches the pages members link to (public hosts only). false = no previews. Default: true
#LINK_PREVIEWS=true
# Scales every rate limit of the server: 2 = twice as many requests; 0 = off, for load tests only.
#RATE_LIMIT_FACTOR=1
# Level of the app server's log: fatal, error, warn, info, debug. Default: info
#LOG_LEVEL=info
# true = one line per request with the caller's IP address, for troubleshooting only. Default: false
#LOG_REQUESTS=false

# ---- Operating mode (set by install.ps1) ----
NODE_ENV=production
# bundled = the Caddy of this installation handles TLS on 443; external = a reverse proxy that is there
PROXY_MODE=external
# What install.ps1 was asked to set up: bundled, local (a proxy on this machine) or remote (a proxy on another one)
SQUORLI_SETUP=local
SQUORLI_LANG=en
# Whose X-Forwarded-* headers are trusted. Comma-separated IPs/CIDRs.
TRUSTED_PROXIES=127.0.0.1
# Address the app server listens on: 127.0.0.1 for a proxy on this machine, this machine's LAN/VPN address for one elsewhere.
LISTEN_HOST=127.0.0.1
# Only for a proxy on another machine: this machine's address the proxy connects to.
#PROXY_BIND_IP=10.0.0.5
# Files of the server: attachments, avatars, previews, reports, the server icon.
DATA_DIR='C:\ProgramData\Squorli\data'
# What `squorli doctor` sends to read the setup check without a session. A secret like the others: a proxy on this machine
# arrives from 127.0.0.1 like the command does, so the address proves nothing here. install.ps1 makes one.
DOCTOR_TOKEN=

# ---- Ports ----
# Where the proxy reaches the app server (PORT is what the server reads, APP_PORT the same number for the tools).
PORT=3000
APP_PORT=3000
# LiveKit signaling (the proxy forwards /rtc to it) and media (open to everyone, straight to LiveKit).
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
# PostgreSQL, on 127.0.0.1 only.
POSTGRES_PORT=5432

# ---- LiveKit ----
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=squorli
LIVEKIT_API_SECRET=change-me-to-at-least-32-random-characters
# Public IP of this machine. Empty = LiveKit determines it itself.
LIVEKIT_NODE_IP=
# Only set if clients should NOT reach LiveKit via https://PUBLIC_DOMAIN/rtc (default: wss://PUBLIC_DOMAIN).
#LIVEKIT_PUBLIC_URL=

# ---- Directory service (handles, friends, encrypted direct messages) ----
# Empty = no directory, the server works on its own (its own accounts: ~name).
DIRECTORY_URL=https://directory.squorli.com
# Server accounts (~name): true/false fixes whether they may be registered; empty = the admin panel decides.
#LOCAL_ACCOUNTS=true
# Only if the directory cannot reach https://PUBLIC_DOMAIN/api/health directly.
#DIRECTORY_PROOF_URL=
