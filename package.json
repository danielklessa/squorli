{
  "name": "squorli",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.1",
  "description": "Selbstgehosteter Community-Chat mit Voice und Video (Server + Client).",
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:desktop": "pnpm --filter @squorli/desktop dev",
    "dev:apps": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "node tools/icons.mjs && node tools/licenses.mjs && pnpm -r build && node tools/copy-web.mjs",
    "icons": "node tools/icons.mjs",
    "emoji": "node tools/emoji.mjs",
    "licenses": "node tools/licenses.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @squorli/server db:generate",
    "smoke": "pnpm --filter @squorli/server smoke",
    "smoke:suspended": "pnpm --filter @squorli/server smoke:suspended",
    "bots": "node tools/bots.mjs",
    "docker:dev": "docker compose -f deploy/compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f deploy/compose.dev.yml down"
  }
}
